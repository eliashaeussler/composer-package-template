{
	"name": "{{ package.composer_name }}",
	"description": "{{ package.description }}",
	"license": "{{ package.license }}",
	"type": "{{ package.type }}",
	"authors": [
		{
			"name": "{{ author.name }}",
			"email": "{{ author.email }}",
{% if author.homepage %}
			"homepage": "{{ author.homepage }}",
{% endif %}
			"role": "{{ author.role }}"
		}
	],
	"require": {
		"php": "{{ dependencies.php|sort|map(version => "~#{version}.0")|join(' || ') }}"
	},
	"require-dev": {
		"armin/editorconfig-cli": "^2.0",
		"eliashaeussler/php-cs-fixer-config": "^3.0",
{% if dependencies.phpstan %}
		"eliashaeussler/phpstan-config": "^4.0",
{% endif %}
{% if dependencies.rector %}
		"eliashaeussler/rector-config": "^4.0",
{% endif %}
		"ergebnis/composer-normalize": "^2.30",
{% if dependencies.phpstan %}
		"phpstan/extension-installer": "^1.4",
{% if dependencies.phpunit %}
		"phpstan/phpstan-phpunit": "^2.0",
{% endif %}
{% endif %}
{% if dependencies.phpunit %}
		"phpunit/phpunit": "{% if '8.2' in dependencies.php %}^11.5 || {% endif %}{% if '8.3' in dependencies.php %}^12.5 || {% endif %}^13.0",
{% endif %}
		"shipmonk/composer-dependency-analyser": "^1.8"
	},
	"autoload": {
		"psr-4": {
			"{{ package.psr4_namespace|replace({'\\': '\\\\'}) }}\\": "src/"
		}
	},
{% if dependencies.phpunit %}
	"autoload-dev": {
		"psr-4": {
			"{{ package.psr4_namespace|replace({'\\': '\\\\'}) }}\\Tests\\": "tests/unit/"
		}
	},
{% endif %}
	"config": {
		"allow-plugins": {
{% if dependencies.phpstan %}
			"phpstan/extension-installer": true,
{% endif %}
			"ergebnis/composer-normalize": true
		},
		"sort-packages": true
	},
	"scripts": {
		"check": [
			"@check:deps",
{% if dependencies.rector %}
			"@check:refactor",
{% endif %}
{% if dependencies.phpstan %}
			"@check:static",
{% endif %}
			"@check:style"
		],
		"check:deps": "composer-dependency-analyser",
{% if dependencies.rector %}
		"check:refactor": [
			"@check:refactor:php"
		],
		"check:refactor:php": "@refactor:php --dry-run",
{% endif %}
{% if dependencies.phpstan %}
		"check:static": "phpstan analyse -c build/checks/phpstan.php",
{% endif %}
		"check:style": [
			"@check:style:composer",
			"@check:style:editorconfig",
			"@check:style:php"
		],
		"check:style:composer": "@fix:composer --dry-run",
		"check:style:editorconfig": "ec --git-only",
		"check:style:php": "@fix:php --dry-run",
		"ci": [
			"@composer validate",
			"@composer audit",
			"@check:deps",
{% if dependencies.rector %}
			"@check:refactor",
{% endif %}
{% if dependencies.phpstan %}
			"@check:static --error-format github",
{% endif %}
			"@check:style"
		],
		"fix": [
			"@fix:composer",
			"@fix:editorconfig",
			"@fix:php"
		],
		"fix:composer": "@composer normalize",
		"fix:editorconfig": "@check:style:editorconfig --fix",
		"fix:php": "php-cs-fixer fix --config build/checks/.php-cs-fixer.php"{% if dependencies.rector or dependencies.phpunit %},{% endif %}
{% if dependencies.rector %}
		"refactor": [
			"@refactor:php"
		],
		"refactor:php": "rector process -c build/checks/rector.php"{% if dependencies.phpunit %},{% endif %}
{% endif %}
{% if dependencies.phpunit %}
		"test": "@test:coverage --no-coverage",
		"test:coverage": "phpunit -c build/tests/phpunit.xml"
{% endif %}
	}
}
