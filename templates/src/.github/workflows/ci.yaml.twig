name: CI

on:
  push:
    branches:
      - '**'
  pull_request:
    branches:
      - main

permissions:
  contents: read

jobs:
  prepare:
    name: 'Prepare workflow'
    uses: eliashaeussler/gha/.github/workflows/preparation.yaml@a6093ebd6b0e93dedcb221832dadcb279bff4cbd # 0.9.1

  checks:
    name: 'Checks'

    needs: [prepare]
    if: {{ "${{ needs.prepare.outputs.continue == 'true' }}" }}

    permissions:
      contents: read
      security-events: write

    uses: eliashaeussler/gha/.github/workflows/checks.yaml@a6093ebd6b0e93dedcb221832dadcb279bff4cbd # 0.9.1
    with:
      # We use the minimum supported PHP version
      php-version: {{ dependencies.php|sort|first }} # renovate-ignore

{% if dependencies.phpunit %}
  tests:
    name: 'Tests (PHP {{ "${{ matrix.php-version }} & ${{ matrix.dependencies }}" }} dependencies)'

    needs: [prepare]
    if: {{ "${{ needs.prepare.outputs.continue == 'true' }}" }}

    strategy:
      fail-fast: false
      matrix:
        php-version: ["{{ dependencies.php|sort|join('", "')|raw }}"]
        dependencies: ["highest", "lowest"]

    uses: eliashaeussler/gha/.github/workflows/composer-tests.yaml@a6093ebd6b0e93dedcb221832dadcb279bff4cbd # 0.9.1
    with:
      php-version: {{ "${{ matrix.php-version }}" }}
      dependencies: {{ "${{ matrix.dependencies }}" }}

  test-coverage:
    name: 'Test coverage'

    needs: [prepare]
    if: {{ "${{ needs.prepare.outputs.continue == 'true' }}" }}

    uses: eliashaeussler/gha/.github/workflows/composer-test-coverage.yaml@a6093ebd6b0e93dedcb221832dadcb279bff4cbd # 0.9.1
{% endif %}
